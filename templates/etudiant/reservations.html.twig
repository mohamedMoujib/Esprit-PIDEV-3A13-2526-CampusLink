{% extends "base.html.twig" %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ===== STATS ===== */
.stats-container {
    display: flex;
    gap: 15px;
    margin-bottom: 24px;
    flex-wrap: wrap;
}

.stat-card {
    flex: 1;
    min-width: 140px;
    background: white;
    padding: 20px;
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    position: relative;
    transition: transform 0.2s;
}

.stat-card::before {
    content: "";
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 4px;
    border-radius: 12px 12px 0 0;
}

.stat-card.total::before     { background: #5D5FEF; }
.stat-card.pending::before   { background: #F59E0B; }
.stat-card.confirmed::before { background: #10B981; }
.stat-card.cancelled::before { background: #EF4444; }

.stat-card h2 {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
    color: #1F2937;
}

.stat-card p {
    margin-top: 6px;
    color: #6B7280;
    font-size: 13px;
}

.stat-card:hover { transform: translateY(-4px); }

/* ===== RESERVATION CARD ===== */
.reservation-card {
    background: white;
    padding: 20px 24px;
    border-radius: 12px;
    margin-bottom: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    gap: 20px;
    flex-wrap: wrap;
}

.reservation-card h3 {
    margin: 0 0 4px;
    font-size: 17px;
    color: #111827;
}

.reservation-card p {
    margin: 2px 0;
    color: #6B7280;
    font-size: 14px;
}

/* ===== PAGINATION (KNP) ===== */
.pagination-box {
    display: flex;
    justify-content: center;
    margin-top: 28px;
}

/* Style KnpPaginator links */
.pagination-box .pagination {
    display: flex;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
    align-items: center;
}

.pagination-box .pagination li a,
.pagination-box .pagination li span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 10px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid #E5E7EB;
    background: white;
    color: #374151;
    transition: all 0.2s;
}

.pagination-box .pagination li a:hover {
    background: #EEF2FF;
    border-color: #5D5FEF;
    color: #5D5FEF;
}

.pagination-box .pagination li.active span,
.pagination-box .pagination li.active a {
    background: #5D5FEF;
    color: white;
    border-color: #5D5FEF;
}

.pagination-box .pagination li.disabled span,
.pagination-box .pagination li.disabled a {
    pointer-events: none;
    opacity: 0.4;
}

/* ===== BUTTONS ===== */
.btn-new {
    background: #5D5FEF;
    color: white;
    padding: 10px 18px;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: opacity 0.2s;
    display: inline-block;
}
.btn-new:hover { opacity: 0.88; }
</style>
{% endblock %}

{% block body %}
<div style="padding:30px;background:#f5f7fb;min-height:100vh;">

    <h2 style="margin-bottom:20px;color:#111827;">Mes Réservations</h2>

    {# ── NOUVELLE RÉSERVATION ── #}
    <div style="text-align:right;margin-bottom:20px;">
        <a href="{{ path('etudiant_reservations', {new:1}) }}" class="btn-new">
            + Nouvelle réservation
        </a>
    </div>

    {# ── FORM NOUVELLE RÉSERVATION ── #}
    {% if showForm %}
    <div style="background:white;padding:24px;border-radius:12px;margin-bottom:24px;box-shadow:0 4px 20px rgba(0,0,0,0.05);">
        <h3 style="margin:0 0 16px;color:#111827;">Nouvelle réservation</h3>

        <form method="post" action="{{ path('etudiant_reservation_new') }}">

            <label style="display:block;margin-bottom:6px;font-size:13px;color:#6B7280;font-weight:500;">
                Service
            </label>
            <select name="service_id" required style="
                width:100%;padding:10px 14px;
                margin-bottom:14px;
                border:1px solid #E5E7EB;
                border-radius:8px;
                font-size:14px;
                color:#374151;
                background:white;
            ">
                {% for s in services %}
                    <option value="{{ s.id }}">{{ s.title }}</option>
                {% endfor %}
            </select>

            <label style="display:block;margin-bottom:6px;font-size:13px;color:#6B7280;font-weight:500;">
                Date & heure
            </label>
            <input type="datetime-local" name="date" required style="
                width:100%;padding:10px 14px;
                margin-bottom:16px;
                border:1px solid #E5E7EB;
                border-radius:8px;
                font-size:14px;
                color:#374151;
                box-sizing:border-box;
            ">

            <button type="submit" style="
                background:#5D5FEF;color:white;
                padding:10px 22px;border:none;
                border-radius:8px;font-size:14px;
                font-weight:600;cursor:pointer;
            ">
                Confirmer
            </button>

        </form>
    </div>
    {% endif %}

    {# ── STATS ── #}
    <div class="stats-container">

        <div class="stat-card total">
            <h2>{{ total }}</h2>
            <p>Total</p>
        </div>

        <div class="stat-card pending">
            <h2>{{ pending }}</h2>
            <p>En attente</p>
        </div>

        <div class="stat-card confirmed">
            <h2>{{ confirmed }}</h2>
            <p>Confirmées</p>
        </div>

        <div class="stat-card cancelled">
            <h2>{{ cancelled }}</h2>
            <p>Annulées</p>
        </div>

    </div>

    {# ── RESERVATION LIST ── #}
    {% for r in reservations %}
    <div class="reservation-card">

        {# LEFT #}
        <div>
            <h3>{{ r.service.title }}</h3>
            <p>avec {{ r.service.user.name }}</p>

            {% if editId == r.id %}
                <form method="post" action="{{ path('etudiant_reservation_edit', {id: r.id}) }}"
                      style="display:flex;gap:8px;align-items:center;margin-top:8px;">
                    <input type="datetime-local" name="date" required
                           style="padding:7px 10px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;">
                    <button type="submit"
                            style="background:#5D5FEF;color:white;border:none;padding:7px 12px;border-radius:8px;cursor:pointer;">
                        ✔
                    </button>
                </form>
            {% else %}
                <p>📅 {{ r.date|date('d M Y H:i') }}</p>
            {% endif %}

            <strong style="color:#5D5FEF;font-size:16px;">{{ r.price }} DT</strong>
        </div>

        {# RIGHT #}
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:10px;">

            {# Status badge #}
            {% if r.status == 'CONFIRMED' %}
                <span style="background:#D1FAE5;color:#059669;padding:5px 12px;border-radius:20px;font-size:13px;font-weight:500;">✔ Confirmée</span>
            {% elseif r.status == 'PENDING' %}
                <span style="background:#FEF3C7;color:#D97706;padding:5px 12px;border-radius:20px;font-size:13px;font-weight:500;">⏳ En attente</span>
            {% else %}
                <span style="background:#FEE2E2;color:#DC2626;padding:5px 12px;border-radius:20px;font-size:13px;font-weight:500;">❌ Annulée</span>
            {% endif %}

            {# Action buttons row #}
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end;">

                {# 📍 Coordination #}
                {% set isCoordinated = coordinationStatus[r.id]|default(false) %}

                {% if isCoordinated %}
                    <span title="Déjà coordonnée" style="background:#E5E7EB;color:#9CA3AF;padding:6px 14px;border-radius:10px;font-size:13px;cursor:not-allowed;opacity:0.7;">
                        📍 Coordination
                    </span>
                {% elseif r.status == 'CONFIRMED' %}
                    <a href="{{ path('payment_index', {id: r.id}) }}"
                       onclick="return confirm('⚠️ Une fois cette réservation coordonnée, c\'est définitif ! Êtes-vous sûr ?');"
                       style="background:#5D5FEF;color:white;padding:6px 14px;border-radius:10px;text-decoration:none;font-size:13px;font-weight:500;">
                        📍 Coordination
                    </a>
                {% elseif r.status == 'PENDING' %}
                    <span title="Disponible après confirmation" style="background:#F3F4F6;color:#9CA3AF;padding:6px 14px;border-radius:10px;font-size:13px;cursor:not-allowed;opacity:0.7;">
                        ⏳ En attente de confirmation
                    </span>
                {% else %}
                    <span title="Coordination indisponible" style="background:#E5E7EB;color:#9CA3AF;padding:6px 14px;border-radius:10px;font-size:13px;cursor:not-allowed;opacity:0.7;">
                        📍 Coordination
                    </span>
                {% endif %}

                {# ❌ Annuler #}
                <form method="post" action="{{ path('etudiant_reservation_cancel', {id: r.id}) }}">
                    <button type="submit" style="background:linear-gradient(135deg,#ff4d4d,#ff0000);color:white;border:none;padding:6px 14px;border-radius:10px;cursor:pointer;font-size:13px;">
                        Annuler
                    </button>
                </form>

                {# ✏️ Modifier #}
                <a href="{{ path('etudiant_reservations', {edit: r.id}) }}"
                   style="background:#E0E7FF;padding:7px 10px;border-radius:8px;text-decoration:none;font-size:14px;"
                   title="Modifier">
                    ✏️
                </a>

                {# 🗑 Supprimer (uniquement si pas confirmée) #}
                {% if r.status != 'CONFIRMED' %}
                <form method="post" action="{{ path('etudiant_reservation_delete', {id: r.id}) }}"
                      onsubmit="return confirm('Supprimer cette réservation ?');">
                    <button type="submit"
                            title="Supprimer"
                            style="background:white;border:none;padding:6px 10px;border-radius:10px;cursor:pointer;box-shadow:0 2px 5px rgba(0,0,0,0.15);font-size:14px;">
                        🗑
                    </button>
                </form>
                {% endif %}

            </div>

            {# 💬 Messagerie #}
            <a href="{{ path('messages', {user: r.service.user.id}) }}"
               style="background:#5D5FEF;color:white;padding:8px 14px;border-radius:10px;text-decoration:none;font-size:13px;font-weight:500;">
                💬 Messagerie
            </a>

        </div>
    </div>
    {% else %}
        <div style="text-align:center;padding:60px 0;color:#9CA3AF;">
            <p style="font-size:40px;margin-bottom:10px;">📭</p>
            <p>Aucune réservation pour le moment.</p>
        </div>
    {% endfor %}

    {# ── PAGINATION (KnpPaginator) — EN DEHORS DE LA BOUCLE for ── #}
    <div class="pagination-box">
        {{ knp_pagination_render(reservations) }}
    </div>

</div>
{% endblock %}
