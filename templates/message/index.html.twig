{% extends "base.html.twig" %}

{% block body %}

<div class="chat-container">

    <!-- SIDEBAR -->
    <div class="sidebar">
        <h3>Messages</h3>

        {% for u in conversations %}
            <a href="{{ path('messages', {user: u.id}) }}"
               class="user-item {{ selectedUser and selectedUser.id == u.id ? 'active' }}">
                {{ u.name ?? u.email }}
            </a>
        {% endfor %}
    </div>

    <!-- CHAT -->
    <div class="chat-box">

        {% if selectedUser %}

        <div class="chat-header">
            💬 {{ selectedUser.name ?? selectedUser.email }}
        </div>

        <div class="messages" id="messagesBox">

            {% for m in messages %}
                {% set isMe = m.sender and m.sender.id == app.user.id %}

                <div class="msg-row {{ isMe ? 'me' }}">

                    <div class="msg-bubble">

                        {% if m.content starts with '[AUDIO]' %}
                            <audio controls>
                                <source src="/uploads/audio/{{ m.content|replace({'[AUDIO]':''}) }}">
                            </audio>
                        {% else %}
                            {{ m.content }}
                        {% endif %}

                        <div class="msg-time">
                            {{ m.createdAt|date('H:i') }}
                        </div>

                        {% if m.scheduledAt and not m.isSent %}
                            <div class="scheduled">
                                🕒 Programmé {{ m.scheduledAt|date('d/m H:i') }}
                            </div>
                        {% endif %}

                    </div>

                </div>
            {% endfor %}

        </div>

        <!-- INPUT -->
        <div class="input-area">

            <form method="post"
                  action="{{ path('message_send', {id: selectedUser.id}) }}"
                  class="input-row">

                <button type="button" onclick="toggleEmoji()">😊</button>
                <button type="button" onclick="startVoice()">🎤</button>

                <input id="messageInput" name="content" placeholder="Écrire un message..." required>

                <input type="datetime-local" name="scheduledAt">

                <button type="submit">➤</button>

            </form>

            <div id="emojiBox"></div>

        </div>

        {% else %}
            <p style="margin:auto;color:#777;font-size:18px;">
                💬 Sélectionnez une conversation
            </p>
        {% endif %}

    </div>

</div>

<!-- JS -->
<script src="https://cdn.jsdelivr.net/npm/emoji-picker-element@1/index.js"></script>

<script>

// auto scroll
let box = document.getElementById("messagesBox");
if(box) box.scrollTop = box.scrollHeight;

// emoji
function toggleEmoji(){
    let box = document.getElementById("emojiBox");

    if(box.innerHTML === ''){
        box.innerHTML = `<emoji-picker></emoji-picker>`;
        box.querySelector('emoji-picker').addEventListener('emoji-click', e => {
            document.getElementById('messageInput').value += e.detail.unicode;
        });
    }

    box.style.display = box.style.display === 'block' ? 'none' : 'block';
}

// 🎤 speech to text
function startVoice(){
    if (!('webkitSpeechRecognition' in window)) {
        alert("Utilise Chrome");
        return;
    }

    const rec = new webkitSpeechRecognition();
    rec.lang = 'fr-FR';

    rec.onresult = e => {
        document.getElementById('messageInput').value += e.results[0][0].transcript;
    };

    rec.start();
}

// 🎙️ audio sécurisé
async function startRecording(){

    {% if selectedUser %}

    let stream = await navigator.mediaDevices.getUserMedia({audio:true});

    let recorder = new MediaRecorder(stream);
    let chunks = [];

    recorder.ondataavailable = e => chunks.push(e.data);

    recorder.onstop = async () => {
        let blob = new Blob(chunks, {type:'audio/webm'});
        let fd = new FormData();
        fd.append('audio', blob);

        await fetch('/messages/send-audio/{{ selectedUser.id }}', {
            method:'POST',
            body:fd
        });

        location.reload();
    };

    recorder.start();
    setTimeout(()=> recorder.stop(), 4000);

    {% else %}
    alert("Sélectionnez une conversation");
    {% endif %}
}
</script>

<!-- CSS -->
<style>

.chat-container{
    display:flex;
    height:90vh;
    background:#f5f7fb;
}

/* sidebar */
.sidebar{
    width:260px;
    background:white;
    padding:15px;
    border-right:1px solid #ddd;
}

.user-item{
    display:block;
    padding:10px;
    border-radius:8px;
    text-decoration:none;
    color:#333;
    margin-bottom:5px;
}

.user-item:hover{
    background:#f0f4ff;
}

.user-item.active{
    background:#2563eb;
    color:white;
}

/* chat */
.chat-box{
    flex:1;
    display:flex;
    flex-direction:column;
    background:#e5e7eb;
}

.chat-header{
    padding:15px;
    background:white;
    border-bottom:1px solid #ddd;
    font-weight:bold;
}

/* messages */
.messages{
    flex:1;
    overflow-y:auto;
    padding:20px;
}

.msg-row{
    display:flex;
    margin-bottom:10px;
}

.msg-row.me{
    justify-content:flex-end;
}

.msg-bubble{
    background:white;
    padding:12px;
    border-radius:14px;
    max-width:60%;
    box-shadow:0 2px 5px rgba(0,0,0,0.1);
}

.msg-row.me .msg-bubble{
    background:#2563eb;
    color:white;
}

.msg-time{
    font-size:10px;
    margin-top:5px;
    opacity:0.7;
}

.scheduled{
    font-size:11px;
    color:orange;
}

/* input */
.input-area{
    padding:10px;
    background:white;
    border-top:1px solid #ddd;
}

.input-row{
    display:flex;
    gap:10px;
    align-items:center;
}

.input-row input{
    flex:1;
    border:none;
    outline:none;
    padding:8px;
    border-radius:8px;
    background:#f3f4f6;
}

button{
    border:none;
    background:#2563eb;
    color:white;
    padding:8px 12px;
    border-radius:8px;
    cursor:pointer;
}

button:hover{
    opacity:0.9;
}

</style>

{% endblock %}